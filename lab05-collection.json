            "description": "Setup: CS201 урьдач нөхцөлтэй CS313 хичээл үүсгэх."
          },
          "response": []
        },
        {
          "name": "POST /registrations — 201 ба result=OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Oracle 1 — статус код",
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// Oracle 2 — хариуны утга",
                  "pm.test(\"Body result is \\\"OK\\\"\", function () {",
                  "  pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentID\": \"B231234567\",\n  \"courseID\": \"CS313\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "description": "Тестлэгдэх функц. Идэвхтэй оюутан CS201 үзсэн, CS313-д CS201 шаарддаг → амжилттай бүртгэл."
          },
          "response": []
        }
